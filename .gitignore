# Compiled binaries
*.exe
*.test
*.out
dayz-manager
dayz-manager-*

# Manager runtime data (created at runtime inside any DayZ server this
# exe is deployed to; should not be in the repo).
.dayz-manager/

# Go — repo-root Go module vendor/ only. The internal/web/static/vendor/
# tree (CodeMirror assets shipped with the binary) must be committed.
/vendor/
go.work
go.work.sum

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
.claude/
.DS_Store
Thumbs.db

# Local dev
*.log
*.tmp
*.bak
*.bak.*

# Reference DayZ server install used for local testing (not distributed).
DayZServer/

# Social-preview cards — uploaded through GitHub Settings, not served from the
# repo, so they live on disk without being tracked. (tools/social_card.py is
# their generator, kept local too; tools/make_icon.py IS tracked.)
docs/social-preview*.png
tools/social_card.py
